class Perpustakaan
    {
    private List<item> koleksi = new List<item>();

    public void tambah_item(item kumpulan_item)
    {
        koleksi.Add(kumpulan_item);
    }
    public void daftar_item()
    {
        Console.WriteLine("\n=== DAFTAR ITEM PERPUSTAKAAN ===");

        foreach (item kumpulan_item in koleksi)
            {
            kumpulan_item.deskripsi();
            Console.WriteLine();
            }
        }
    }

class program
{
    static void Main()
    {
        Perpustakaan perpustakaan1 = new Perpustakaan();

        komik komik1 = new komik("MCU", 2000, "Stan Lee");
        novel novel1 = new novel("Laskar Pelangi", 2005, "Andrea Hirata");
        majalah majalah1 = new majalah("Prabowo Pidato", 2024, 10);
        majalah_anak Spongebob = new majalah_anak("Bobon", 2025, 12);
        majalah_teknologi ilmu_jago = new majalah_teknologi("Polytron Memang Canggih", 2025, 5);

        perpustakaan1.tambah_item(komik1);
        perpustakaan1.tambah_item(novel1);
        perpustakaan1.tambah_item(majalah1);
        perpustakaan1.tambah_item(Spongebob);
        perpustakaan1.tambah_item(ilmu_jago);

        novel1.deskripsi();
        majalah1.deskripsi();
        Console.WriteLine();
        

        novel1.baca_sinopsis();
        Console.WriteLine();

        novel1.info_item();
        novel1.cek_penulis();
        Console.WriteLine();

        ilmu_jago.topik_teknologi();
        Console.WriteLine();

        item itemKomik = komik1;
        itemKomik.deskripsi();
        Console.WriteLine();
    }
}

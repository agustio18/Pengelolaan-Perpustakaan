using System;
using System.Globalization;

class item
{
    public string judul;
    public int tahun;
    public item(string Judul, int Tahun)
    {
        this.judul = Judul;
        this.tahun = Tahun;
    }
    public void info_item()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
    }
    public virtual void deskripsi()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
    }
}

class buku : item
{
    public string penulis;

    public buku(string Judul, int Tahun, string Penulis) : base(Judul, Tahun)
    {
        this.penulis = Penulis;
    }
    public void cek_penulis()
    {
        Console.WriteLine($"Buku ini ditulis oleh {this.penulis}");
    }
    public override void deskripsi()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
        Console.WriteLine("Penulis : " + penulis);
    }
}

class majalah : item
{
    public int edisi;
    public majalah (string Judul, int Tahun, int Edisi) : base(Judul, Tahun) 
    {
        this.edisi = Edisi;
    }
    public void info_edisi()
    {
        Console.WriteLine("Majalah ini merupakan edisi tahun " + edisi);
    }
    public override void deskripsi()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
        Console.WriteLine("Edisi : " + edisi);
    }
}

class novel : buku
{
    public novel (string Judul, int Tahun, string Penulis) : base(Judul, Tahun, Penulis) {}

    public override void deskripsi()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
        Console.WriteLine("Penulis : " + penulis);
    }
    public void baca_sinopsis ()
    {
        Console.WriteLine("Ini merupakan sinopsis dari novel " + judul);
    }
}

class komik : buku
{
    public komik(string Judul, int Tahun, string Penulis) : base(Judul, Tahun, Penulis) { }

    public override void deskripsi()
    {
        Console.WriteLine("Judul : " + judul);
        Console.WriteLine("Tahun : " + tahun);
        Console.WriteLine("Penulis : " + penulis);
    }
    public void tampilkan_ilustrasi()
    {
        Console.WriteLine("Ini merupakan ilustrasi dari komik " + judul);
